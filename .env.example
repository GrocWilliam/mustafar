# Claude credentials: set ONE of the two (API key, or subscription token from `claude setup-token`).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Orchestrator only, never given to agents. Projects are the repos with the `forge` topic (./new-project.sh).
GITEA_TOKEN=

POLL_SECONDS=30
# Specs and US worked on at once, across all projects. Keep the runner capacity (runner/config.yaml) at least as high.
MAX_AGENTS=2

# act_runner registration (README step 3).
GITEA_RUNNER_REGISTRATION_TOKEN=
# Path prefixes a PR must not touch, comma-separated; such a PR is blocked, never merged.
PROTECTED_PATHS=.gitea/
# A spec's remaining stories are blocked once its agents have cost more than this (USD, as reported by Claude Code).
MAX_COST_PER_SPEC=20
